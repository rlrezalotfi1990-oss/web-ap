{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a79c0414-ee76-4ca2-92dc-87d78da390d3","database_name": "web-ap" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e648ffad5e524b41a2dc37ca4b4e3b55" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
